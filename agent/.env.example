# Copy to agent/.env and fill in. Never commit agent/.env.

# Gemini (Google AI Studio key). Without it CHIEF answers in fallback mode.
GEMINI_API_KEY=
# Check the exact Pro model name available to your account (see agent/README.md).
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURE=0.4
LLM_TIMEOUT_SECONDS=45

# Speech-to-text (faster-whisper): tiny.en, base.en, small.en...
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# Text-to-speech (Piper): path to the .onnx voice, relative to agent/
PIPER_VOICE_PATH=models/piper/en_US-ryan-medium.onnx
