# Copy to agent/.env and fill in. Never commit agent/.env.

# Gemini (Google AI Studio key). Without it CHIEF answers in fallback mode.
GEMINI_API_KEY=
# Models tried in order, comma-separated, without the "models/" prefix. When one fails
# (quota, overload, not available) the next one answers. See agent/README.md.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.4
# Time limit for one answer across the whole chain. Past it, CHIEF falls back.
# Keep it below the backend AGENT_TIMEOUT_MS (20 s).
LLM_TIMEOUT_SECONDS=15

# Speech-to-text (faster-whisper): tiny.en, base.en, small.en...
WHISPER_MODEL=base.en
WHISPER_COMPUTE_TYPE=int8

# Text-to-speech (Piper): path to the .onnx voice, relative to agent/
PIPER_VOICE_PATH=models/piper/en_US-ryan-medium.onnx

# Load the voice models in the background at startup (false: on the first request).
VOICE_PRELOAD=true
