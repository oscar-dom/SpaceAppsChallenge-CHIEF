# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

# NASA API key for DONKI (free at https://api.nasa.gov). Used by `npm run data:fetch -w backend`.
# Without it the script uses DEMO_KEY, which is rate limited.
NASA_API_KEY=

# Optional: path of the SQLite database. Default: backend/var/chief.db
CHIEF_DB_PATH=
# Copy to backend/.env and adjust. Every variable is optional: the defaults below work
# for local development. No secrets live here: the Gemini key belongs to agent/.env.

PORT=3000
# Frontend origin allowed by CORS and Socket.IO.
CORS_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Python agent (CHIEF).
AGENT_URL=http://localhost:8000
AGENT_TIMEOUT_MS=20000

# Mission clock: simulated seconds per real second. Default: the mission's own scale
# (backend/data/crew.ts, 600 = ten simulated minutes per second).
# TIME_SCALE=600
# Real milliseconds between two ticks of the live loop.
TICK_INTERVAL_MS=1000
# false serves the database as it is, without new readings.
SIMULATOR_ENABLED=true

# Another database file (tests, demo copies). Default: backend/var/chief.db
# CHIEF_DB_PATH=
