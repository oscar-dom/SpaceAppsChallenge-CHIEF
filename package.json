{
  "name": "chief",
  "private": true,
  "description": "CHIEF: crew health system for a simulated ISS mission (NASA Space Apps Challenge)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "concurrently --kill-others-on-fail -n backend,frontend,agent -c blue,green,magenta \"npm run dev -w backend --if-present\" \"npm run dev -w frontend --if-present\" \"node scripts/dev-agent.mjs\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
